{
	"name": "dsh-pi-memory",
	"version": "0.1.0",
	"description": "跨会话持久记忆（移植自 pi-memory）",
	"main": "index.js",
	"type": "module",
	"keywords": [
		"dsh",
		"dsh-plugin",
		"deepseek-harness",
		"memory",
		"search",
		"qmd",
		"scratchpad",
		"daily-log"
	],
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		}
	},
	"author": "jayzeng",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/GongYuanCaiJi/dsh-pi-memory.git"
	},
	"bugs": {
		"url": "https://github.com/GongYuanCaiJi/dsh-pi-memory/issues"
	},
	"homepage": "https://github.com/GongYuanCaiJi/dsh-pi-memory#readme",
	"files": [
		"index.js",
		"scripts",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"THIRD_PARTY_NOTICES.md",
		"cordis.patch.yml"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"//postinstall": "upstream scripts/postinstall.cjs is kept byte-identical in files/ (see THIRD_PARTY_NOTICES) but NOT wired as postinstall: pnpm 11 refuses tarball installs with build scripts (ERR_PNPM_IGNORED_BUILDS), and the script is a dev-checkout-only git-hooks no-op (no .githooks in this repo) — it would do nothing even if it ran. See porting ticket #18.",
		"build": "node --check index.js",
		"lint": "biome check .",
		"test": "node --test test/unit.test.js test/qmd-cache.test.js",
		"test:e2e": "node test/e2e.mjs",
		"test:eval": "node test/eval-recall.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.0"
	},
	"dependencies": {
		"@deepseek-ai/schemastery": "3.18.1"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
